# The DAPS base image
# hadolint ignore=DL3007
FROM registry.opensuse.org/documentation/containers/15.6/opensuse-daps-toolchain:latest

# Packages to install
ARG BASE_PACKAGES="bash-completion \
  command-not-found \
  curl \
  diffutils \
  findutils \
  gawk \
  gh \
  git \
  glibc-locale-base \
  gpg2 \
  grep \
  gzip \
  inotify-tools \
  jq \
  make \
  npm-default \
  openssh-clients \
  patch \
  procps \
  ripgrep \
  shadow \
  sudo \
  tar \
  wget \
  which \
  xz \
  yq"

# Disable the openH.264 repo to have faster refresh
# hadolint ignore=SC1091
# RUN zypper modifyrepo --disable openSUSE:repo-openh264

# Install the packages
# hadolint ignore=DL3036
RUN zypper --non-interactive --gpg-auto-import-keys install --no-recommends $BASE_PACKAGES

# Set up a non-root user (recommended for dev containers)
# hadolint ignore=DL3064
ARG USERNAME=vscode
RUN useradd -s /bin/bash --uid 1000 --gid users -m $USERNAME \
    && mkdir -p /etc/sudoers.d/ \
    && echo "$USERNAME ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

# Set the default user
USER $USERNAME
